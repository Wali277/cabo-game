# =============================================================================
# server/.env.example — environment for the trusted-server AUTH layer (Phase 1)
# -----------------------------------------------------------------------------
# Copy to `server/.env` and fill in real values. These are read via process.env
# (the auth module calls requireEnv() LAZILY, so the server can still boot for
# non-auth use when they're unset — but every /auth route will then fail with a
# clear "Missing required environment variable: <NAME>" error).
#
# SECURITY: every value below is SERVER-ONLY. NONE of these may ever be sent to
# the client/browser or written to a log. In particular the service_role key
# grants full DB access (it bypasses RLS) and the anon key + Resend key must
# stay on the server.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Your project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Public anon key. Used ONLY to perform password sign-in (signInWithPassword)
# so the server can mint a real user session. RLS-constrained.
SUPABASE_ANON_KEY=

# Service-role (secret) key. Bypasses RLS — full privileged DB access. Used for
# creating auth users, reading/writing profiles + email_codes, confirming
# emails, resetting passwords. NEVER expose this to any client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (transactional email) --------------------------------------------
# Resend API key used to deliver the 6-digit verification / reset codes.
RESEND_API_KEY=

# The verified "from" address codes are sent from, e.g. "LUMO <auth@yourdomain>".
RESEND_FROM=

# Where in-app bug-report digest emails are sent. The Report Bug form saves every
# report to the bug_reports table; every 5th UNRESOLVED report the server emails
# this address a nudge to go review them. If unset, the nudge falls back to
# RESEND_FROM (sends to self) so the alert is never silently dropped.
BUG_REPORT_TO=

# --- Auth code signing -------------------------------------------------------
# Secret key used to HMAC-SHA256 the 6-digit codes before storing them. Codes
# are NEVER stored or logged in plaintext; only HMAC(code, AUTH_CODE_SECRET) is
# persisted. Use a long random string (e.g. `openssl rand -hex 32`). Rotating
# this invalidates all outstanding (unconsumed) codes.
AUTH_CODE_SECRET=

# --- Ko-fi donation webhook (buy-tokens) -------------------------------------
# The verification token from Ko-fi → Settings → API/Webhooks. POST /webhooks/kofi
# is gated ENTIRELY on this (constant-time compare); if it's unset the endpoint
# FAILS CLOSED (503) so no one can mint tokens. NEVER expose or log it.
KOFI_VERIFICATION_TOKEN=

# OPTIONAL extra scoping: the Ko-fi Shop product's direct_link_code for your
# "buy tokens" item. If set, ONLY shop orders containing that product grant
# tokens; if blank, ANY Ko-fi "Shop Order" grants tokens (plain donations never
# do, regardless). Leave blank unless your shop also sells non-token products.
KOFI_TOKEN_PRODUCT_CODE=
