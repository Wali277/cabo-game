{
  "name": "cobo-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build:client": "npm --prefix ../cobo run build",
    "serve": "npm run build:client && npm start",
    "share": "node scripts/share.mjs",
    "check:bust": "node --import tsx scripts/check-bust.ts",
    "check:roundresolve": "node --import tsx scripts/check-roundresolve.ts",
    "check:spbust": "node --import tsx test-spbust.mts",
    "check:sp-sd-loop": "node --import tsx test-sp-sd-loop.mts",
    "check:sdloop": "node --import tsx scripts/check-sd-loop.ts",
    "check:cosmetics": "node --import tsx scripts/check-cosmetics.ts",
    "check:kofi": "node --import tsx scripts/check-kofi-webhook.ts",
    "check:reset": "node --env-file-if-exists=.env --import tsx scripts/check-reset.ts",
    "check:redeem": "node --env-file-if-exists=.env --import tsx scripts/check-redeem.ts",
    "check:kick": "node --import tsx scripts/check-kick.ts",
    "check:decopurchase": "node --env-file-if-exists=.env --import tsx scripts/check-deco-purchase.ts",
    "check:levelrewards": "node --env-file-if-exists=.env --import tsx scripts/check-level-rewards.ts",
    "render:email": "node --import tsx scripts/render-email.ts",
    "test:rules": "npm run check:bust && npm run check:roundresolve && npm run check:sdloop && npm run check:spbust"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.2.0",
    "localtunnel": "^2.0.2",
    "resend": "^4",
    "socket.io": "^4.8.1",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.7.2"
  }
}
