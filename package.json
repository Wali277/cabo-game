{
  "name": "cobo-game",
  "version": "3.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "npm install --prefix cobo && npm install --prefix server",
    "build": "npm run build --prefix cobo",
    "start": "npm start --prefix server",
    "electron:build-client": "cd cobo && npx vite build --mode electron",
    "electron:make-icon": "node scripts/make-icon.mjs",
    "electron:dev": "npm run electron:build-client && npx electron electron/main.js",
    "electron:build": "npm run electron:make-icon && npm run electron:build-client && npx electron-builder --win --x64 --publish never",
    "electron:build-mac": "npm run electron:make-icon && npm run electron:build-client && npx electron-builder --mac --arm64 --publish never && mkdir -p \"$HOME/Downloads/Lumo Mac\" && cp dist-electron/*.dmg \"$HOME/Downloads/Lumo Mac/\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.cobo.game",
    "productName": "Lumo",
    "copyright": "Copyright © 2025",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "cobo/dist/**/*"
    ],
    "mac": {
      "target": [{ "target": "dmg", "arch": "arm64" }],
      "icon": "build/icon.png",
      "category": "public.app-category.games"
    },
    "dmg": {
      "title": "Lumo",
      "icon": "build/icon.png",
      "window": { "width": 540, "height": 380 },
      "contents": [
        { "x": 150, "y": 185, "type": "file" },
        { "x": 390, "y": 185, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumo"
    }
  }
}
