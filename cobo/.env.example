# ────────────────────────────────────────────────────────────────────────────
# Lumo client environment (Vite) — copy to `.env.local` and fill in.
# Only VITE_-prefixed vars are exposed to the browser bundle.
# ────────────────────────────────────────────────────────────────────────────

# Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Supabase ANON (public) key. This is safe to ship in the client — Row Level
# Security guards the data. NEVER put the service-role / secret key here.
VITE_SUPABASE_ANON_KEY=
